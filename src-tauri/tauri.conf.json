{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Livery",
  "version": "0.3.2",
  "identifier": "app.livery.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Livery",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "backgroundColor": "#131416"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://cdn-live.warthunder.com https://images-live.warthunder.com; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "War Thunder user-skin manager",
    "longDescription": "Unofficial tool, not affiliated with Gaijin Entertainment.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Italian", "German", "Russian", "French", "Spanish", "Polish", "PortugueseBR", "SimpChinese"],
        "customLanguageFiles": { "Polish": "nsis/Polish.nsh" },
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "startMenuFolder": "Livery"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4N0FDQTU5NDEwRUQxQjYKUldTMjBRNUJXY3A2S0RLRWFaZlNLbnpMWllnMFpBZ2l0akRnSDRUL1dKMEh3cnY3UndqVS80d3YK",
      "endpoints": ["https://github.com/Pier144/Livery/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
